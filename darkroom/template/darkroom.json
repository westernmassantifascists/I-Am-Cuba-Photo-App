{
  "title": "Low Tide",
  "id": "",
  "author": "",
  "start": "Arrival",
  "mode": "page",
  "beat": "paragraph",
  "typewriter": 0,
  "bg_fade": 1.5,
  "bg_fit": "cover",
  "meters": {
    "longing": {
      "start": 20,
      "min": 0,
      "max": 100
    },
    "dread": {
      "start": 10,
      "min": 0,
      "max": 100
    },
    "tenderness": {
      "start": 10,
      "min": 0,
      "max": 100
    }
  },
  "scene": {
    "aliases": {
      "motif": {
        "room": "interior"
      }
    },
    "volume": {
      "music": 0.6,
      "ambience": 0.35
    },
    "mix": {
      "music": "0.45 + $longing * 0.003 - $dread * 0.001",
      "music_range": [
        0.2,
        0.8
      ],
      "ambience": "0.2 + $dread * 0.004",
      "ambience_range": [
        0.1,
        0.7
      ]
    },
    "weights": [
      {
        "when": "$dread > 50",
        "favor": {
          "dark": 15,
          "soft": 10,
          "soft-dark": 10
        }
      },
      {
        "when": "$longing > 50",
        "favor": {
          "cool": 15,
          "distance": 10,
          "hard-cool": 10
        }
      },
      {
        "when": "$tenderness > 50",
        "favor": {
          "warm": 15,
          "vivid": 10,
          "warm-vivid": 10
        }
      }
    ],
    "look_rules": [
      {
        "when": "$dread >= 45",
        "look": "soft-dark"
      },
      {
        "when": "$tenderness >= 45",
        "look": "warm-vivid"
      },
      {
        "when": "$longing >= 35",
        "look": "hard-cool"
      }
    ],
    "look_floor": {
      "opacity": 0.8,
      "brightness": 0.8
    },
    "first_run_shots": true
  },
  "characters": {},
  "title_screen": {
    "background": "title",
    "music": "music/longing",
    "subtitle": "A town the sea is taking back"
  },
  "theme": {},
  "lean": {
    "image_max": 1920,
    "image_format": "webp",
    "image_quality": 80,
    "audio_bitrate": 128,
    "video_max_height": 720,
    "video_crf": 26
  },
  "itch": {
    "max_files": 1000,
    "max_total_mb": 500,
    "max_file_mb": 200
  }
}
