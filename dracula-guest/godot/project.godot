; Engine configuration file.
; Dracula's Guest — a Darkroom piece for Godot 4.3+

config_version=5

[application]

config/name="Dracula's Guest"
config/description="Bram Stoker's Dracula's Guest (1914), walked: photogrammetry scans, public-domain film, a score made on the Darkroom groovebox."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Story="*res://scripts/story.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method.web="gl_compatibility"

anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

texture={
"compress/mode": 1,
"compress/lossy_quality": 0.8,
"mipmaps/generate": true
}
